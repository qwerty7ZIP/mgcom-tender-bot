# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Секретный токен для приёма снапшотов таблицы от Apps Script.
# Тот же самый токен нужно вписать в apps_script/Code.gs (INGEST_TOKEN).
# Сгенерируй длинную случайную строку, например: openssl rand -hex 32
INGEST_TOKEN=замени_на_длинный_случайный_токен

# На каком интерфейсе/порту бот принимает снапшоты (POST /ingest).
# Порт должен быть доступен извне (firewall), чтобы Apps Script мог достучаться.
INGEST_HOST=0.0.0.0
INGEST_PORT=8080

# Список доверенных пользователей (whitelist) одной строкой JSON.
# login   — username в Telegram (без @)
# setter  — значение в колонке "Постановщик" в таблице
# greeting — (необязательно) как обращаться; если не указать, возьмётся имя из Telegram
USERS_JSON=[{"login":"katya_ivanova","setter":"Екатерина Иванова","greeting":"Кать"},{"login":"ivan_petrov","setter":"Иван Петров","greeting":"Вань"}]

# --- Необязательные настройки (можно не указывать) ---

# Время ежедневной рассылки (по TZ ниже)
SEND_HOUR=11
SEND_MINUTE=0
TZ=Europe/Moscow

# Слать ли сообщение, если просрочек нет (false = молчать)
SEND_WHEN_EMPTY=false

# Названия колонок, если в таблице они отличаются от значений по умолчанию
# COL_ID=ID
# COL_NAME=Название
# COL_SETTER=Постановщик
# COL_DEADLINE=Дата окончания
# COL_LINK=Ссылка
