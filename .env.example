# Токен бота от @BotFather
BOT_TOKEN=

# Секретный токен для приёма снапшотов таблицы от Apps Script.
# Тот же самый токен нужно вписать в apps_script/Code.gs (INGEST_TOKEN).
# Сгенерируй длинную случайную строку, например: openssl rand -hex 32
INGEST_TOKEN=

# На каком интерфейсе/порту бот принимает снапшоты (POST /ingest).
# Все данные (просрочка и принятие решения) приходят из Google-снапшота.
INGEST_HOST=0.0.0.0
INGEST_PORT=8080

# Список доверенных пользователей (whitelist). Два способа задать:
#   1) Файл users.json (рекомендуется — читаемый многострочный JSON).
#      Если USERS_JSON ниже не задан, бот читает users.json (см. users.json.example).
#   2) Переменная USERS_JSON одной строкой (имеет приоритет, если задана).
#
# Поля: login — username в Telegram (без @); setter — значение в колонке
# "Постановщик" (обязательно для manager/head); greeting — необязательно;
# role — "manager" (по умолчанию), "admin" или "head".
#
# Чтобы использовать users.json — просто НЕ задавай USERS_JSON (оставь закомментированным):
# USERS_JSON=[{"login":"boss_login","greeting":"Шеф","role":"admin"}]

# --- Необязательные настройки (можно не указывать) ---

# Времена ежедневной рассылки (по TZ ниже), через запятую в формате HH:MM
SEND_TIMES=11:00,17:00
TZ=Europe/Moscow

# Слать ли сообщение, если просрочек нет (false = молчать)
SEND_WHEN_EMPTY=false

# Имена листов в таблице (должны совпадать с SHEET_NAMES в apps_script/Code.gs)
# PRIMARY_SHEET=Просрок чистка
# DECISION_SHEET=Принятие чистка

# Названия колонок, если в таблице они отличаются от значений по умолчанию
# COL_ID=ID
# COL_NAME=Название
# COL_SETTER=Постановщик
# COL_DEADLINE=Дата окончания
# COL_LINK=Ссылка

# --- Прогноз повторных тендеров (кнопка «Ближайшие тендеры» + напоминания) ---
# Значения по умолчанию подходят под лист «Импорт» — менять ничего не нужно.
# Лист со всеми сделками (его имя нужно добавить в SHEET_NAMES в Code.gs)
# TENDERS_SHEET=Импорт
# Записи одного тендера: совпало название сделки (без регистра, знаков препинания и годов)
# TENDER_MATCH_COLS=Название сделки
# TENDER_COL_INVITE=Дата приглашения
# Запасные даты для проверки «тендер этого года уже заведён», если дата приглашения пустая
# TENDER_FALLBACK_DATE_COLS=Дата начала КП,Дата окончания КП,ДЛ
# TENDER_COL_NAME=Название сделки
# TENDER_COL_LINK=Ссылка
# Показывается в сообщении как «Ответственный»
# TENDER_COL_SETTER=Ответственный
# Доп. информация в сообщении (показываются только непустые)
# TENDER_INFO_COLS=Тип тендера,Сумма тендера,Статус тендера (Этап),Предмет тендера
# Цикл тендера и за сколько предупреждать
# TENDER_CYCLE_MONTHS=12
# TENDER_LEAD_MONTHS=3
# Сколько дней ещё показывать тендер, если ожидаемая дата прошла, а записи нет
# TENDER_GRACE_DAYS=30
# Запись клиента позже прошлого тендера на столько дней = тендер этого года уже есть
# TENDER_FRESH_DAYS=180
# Время ежедневной проверки напоминаний (по умолчанию — первое из SEND_TIMES)
# TENDER_NOTIFY_TIME=11:00
